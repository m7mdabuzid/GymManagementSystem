<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymManagementSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymManagementSystem.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark gym-navbar border-bottom mb-3">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand gym-brand" asp-controller="Home" asp-action="Index">
                    GymManagementSystem
                </a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar content -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Members" asp-action="Index">Members</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="ClassSessions" asp-action="Index">Sessions</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Trainers" asp-action="Index">Trainers</a>
                        </li>

                    </ul>

                    <!-- Login & user info -->
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>


    <!-- Main Content -->
    <div class="container pt-2">
        <main role="main" class="pb-3">
            @RenderBody()
            <main role="main" class="pb-3">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success alert-gym" role="alert">
                        @TempData["Message"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-gym" role="alert">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>

        </main>
    </div>


    <!-- Footer -->
    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2025 - GymManagementSystem -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
