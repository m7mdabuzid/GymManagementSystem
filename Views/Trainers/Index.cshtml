@model IEnumerable<GymManagementSystem.Models.Trainer>

<h2>Trainers</h2>

<p>
    <a asp-controller="Members" asp-action="Index">Back to Members</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Specialization</th>
            <th>Number of Classes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.Specialization</td>
                <td>@t.AssignedClasses.Count</td>
                <td>
                    <a asp-action="Details" asp-route-id="@t.TrainerId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

