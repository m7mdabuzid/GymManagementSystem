@model GymManagementSystem.Models.Member

<h2>Edit Member</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MemberId" />

    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <label>Membership Type</label>
        <select asp-for="MembershipType" class="form-control"
                asp-items="Html.GetEnumSelectList<GymManagementSystem.Models.MembershipType>()">
        </select>
    </div>

    <div class="form-group mt-2">
        <label>Active?</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>

    <div class="form-group mt-2">
        <label>Membership End Date</label>
        <input asp-for="MembershipEndDate" class="form-control" type="date" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
