@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-container mt-4">
    <div class="gym-card">
        <h1 class="page-title mb-3">Privacy Policy</h1>

        <p>
            This system is designed for managing gym members, sessions, and trainers.
            We collect only the information required to operate the platform, such as:
        </p>

        <ul>
            <li>Member names and membership details</li>
            <li>Trainer and session schedules</li>
            <li>Basic login and authentication data</li>
        </ul>

        <p>
            Your information is used strictly for administrative purposes inside the gym.
            We do <strong>not</strong> share, sell, or disclose your data to external parties.
        </p>

        <h4 class="mt-4">Data Security</h4>
        <p>
            All stored information is protected through standard security practices.
            Access is restricted to authorized staff members only.
        </p>

        <h4 class="mt-4">Your Control</h4>
        <p>
            You may request to update or remove your personal information at any time
            by contacting the system administrator.
        </p>

        <p class="mt-4">
            If you have questions regarding data usage or security, please reach out to management.
        </p>
    </div>
</div>
